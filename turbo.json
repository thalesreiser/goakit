{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "outputs": []
    },
    "expo:check": {
      "cache": false,
      "passThroughEnv": ["CI", "EXPO_*"]
    },
    "export": {
      "env": ["EXPO_PUBLIC_*"],
      "passThroughEnv": ["CI", "EXPO_*"],
      "outputs": ["dist/**"]
    }
  }
}
