{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    ".nvmrc",
    "package.json",
    "pnpm-workspace.yaml",
    ".github/workflows/ci.yml",
    ".github/actions/setup/action.yml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "openapi": {
      "dependsOn": ["build"],
      "outputs": ["dist/openapi.json"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "outputs": []
    },
    "expo:check": {
      "cache": false,
      "passThroughEnv": ["CI", "EXPO_*"]
    },
    "export": {
      "env": ["EXPO_PUBLIC_*"],
      "passThroughEnv": ["CI", "EXPO_*"],
      "outputs": ["dist/**"]
    }
  }
}
