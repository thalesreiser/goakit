# Copy to .env for local runs (`pnpm --filter @goakit/api start` loads it).
# Never commit a real .env file.

# Required. One of: development, test, production.
NODE_ENV=development
# Required. TCP port the API listens on (1-65535).
PORT=3000
# Optional. Interface to bind; defaults to 0.0.0.0.
HOST=0.0.0.0
# Optional. One of: fatal, error, warn, info, debug, trace, silent; defaults to info.
LOG_LEVEL=info
