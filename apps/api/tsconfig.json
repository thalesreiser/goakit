{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@goakit/config/tsconfig/strict.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "types": ["node"],
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // NestJS relies on legacy decorators and on constructor parameter
    // metadata for dependency injection.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": true
  },
  "include": ["src", "test", "vitest.config.mts"]
}
